# --- Tutor engine -----------------------------------------------------------
# true  -> hardcoded demo decisions (no AWS needed). Build/rehearse with this.
# false -> real Amazon Bedrock call (needs BEDROCK_MODEL_ID + AWS credentials).
# If unset: mock is used unless BEDROCK_MODEL_ID is set.
MOCK_AI=true

# --- Amazon Bedrock (only used when MOCK_AI is not true) --------------------
AWS_REGION=us-east-1
# A Claude model or inference-profile ID that is enabled in your AWS account.
BEDROCK_MODEL_ID=
# Credentials come from the standard AWS chain (env vars, profile, role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Learner store ----------------------------------------------------------
# file   -> in-memory + best-effort write to .data/learners.json (default)
# memory -> in-memory only. Serverless hosts (Vercel/Amplify) need a real store
#           such as DynamoDB: implement the LearnerStore interface.
LEARNER_STORE=file
